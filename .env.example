# =============================================================================
# Assistant MCP Server — пример конфигурации
# =============================================================================
# Скопируй в .env и заполни своими значениями:
#   cp .env.example .env
#
# .env добавлен в .gitignore — НЕ публикуй его в git.
# В Docker значения задаются через docker-compose env.
# =============================================================================

# --- Подключение к бэкенду ---
# URL REST API бэкенда (без trailing slash)
# Локальная разработка: http://localhost:8081/api/v1
# VPS через WireGuard:  http://10.0.0.1:8081/api/v1
# VPS через HTTPS:      https://assistant.905911.ru/api/v1
BACKEND_URL=http://localhost:8081/api/v1

# --- Аутентификация на бэкенде ---
# Должен совпадать с API_KEY бэкенда
# Генерация: openssl rand -hex 32
API_KEY=your-super-secret-api-key-change-me-in-production

# --- MCP-сервер ---
SERVER_NAME=assistant-mcp
SERVER_VERSION=0.1.0

# --- Транспорт (опционально) ---
# stdio — когда MCP-клиент сам запускает процесс
# http  — Streamable HTTP (для Qwen Desktop, VPS)
# MCP_TRANSPORT=http
# MCP_PORT=8082
